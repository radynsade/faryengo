DATABASE_URL=postgres://faryen:change-me@127.0.0.1:5432/faryen?sslmode=require
REDIS_URL=rediss://127.0.0.1:6379/0
HTTP_ADDRESS=:8080
# JWT API mechanism settings; the admin-only server does not initialize JWT.
# Generate with: openssl rand -base64 32
JWT_SIGNING_SEED=
JWT_KEY_ID=v1
JWT_ISSUER=faryen
JWT_ACCESS_AUDIENCE=faryen-admin
JWT_REFRESH_AUDIENCE=faryen-refresh
ACCESS_TOKEN_TTL=5m
REFRESH_TOKEN_TTL=720h
# Absolute browser session lifetime; independent of JWT access and refresh tokens.
SESSION_TTL=168h
# Keep true in production, with HTTPS terminated by a trusted reverse proxy.
AUTH_COOKIE_SECURE=true
