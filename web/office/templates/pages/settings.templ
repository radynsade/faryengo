package pages

import "github.com/radynsade/faryengo/web/office/templates/components"

// SettingsFormFailure is the response to a failed in-page submission on
// either settings page: the form with its errors, and no confirmation of an
// earlier change.
templ SettingsFormFailure(form templ.Component) {
	@form
	@components.Messages(nil, true)
}
