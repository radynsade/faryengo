package pages

import (
	"github.com/radynsade/faryengo/internal/users"
	officei18n "github.com/radynsade/faryengo/web/office/i18n"
	"github.com/radynsade/faryengo/web/office/templates/components"
	"github.com/radynsade/faryengo/web/office/templates/layouts"
)

// The forms and their password confirmations name the regions a failed
// in-page submission replaces.
const (
	ProfileFormID     = "profile-form"
	ProfileConfirmID  = "profile-confirm"
	PasswordFormID    = "password-form"
	PasswordConfirmID = "password-confirm"
)

// The confirmation opens on its own when the server asks for the current
// password, and with JavaScript before a submission that needs it.

type ConfirmProps struct {
	Open  bool
	Error string
}

type ProfileFormProps struct {
	Action      string
	CancelURL   string
	FirstName   string
	LastName    string
	Email       string
	UpdatedAt   string
	Error       string
	FieldErrors map[string]string
	Confirm     ConfirmProps
}

type PasswordFormProps struct {
	Action      string
	CancelURL   string
	Error       string
	FieldErrors map[string]string
	Confirm     ConfirmProps
}

type SettingsContentProps struct {
	Notices  []string
	Profile  ProfileFormProps
	Password PasswordFormProps
}

type SettingsProps struct {
	Layout  layouts.StandaloneProps
	Content SettingsContentProps
}

// Settings outside a workspace stand alone, without the sidebar.
templ Settings(props SettingsProps) {
	@layouts.Standalone(props.Layout) {
		<section class="standalone__section settings">
			<header class="standalone__heading">
				<h1 id="page-title">{ officei18n.T(ctx, "nav.settings") }</h1>
			</header>
			@SettingsContent(props.Content)
		</section>
	}
}

// WorkspaceSettings shows the same settings as a section of a workspace.
templ WorkspaceSettings(dashboard layouts.DashboardProps, content SettingsContentProps) {
	@layouts.Dashboard(dashboard) {
		<div class="settings">
			@SettingsContent(content)
		</div>
	}
}

// SettingsContent opens with the confirmations of a saved change, which come
// from the flash messages the redirect left for this page.
templ SettingsContent(props SettingsContentProps) {
	@settingsNotices(props.Notices, false)
	<section class="settings__section" aria-labelledby="profile-title">
		<header class="settings__heading">
			<h2 id="profile-title">{ officei18n.T(ctx, "settings.profile") }</h2>
			<p>{ officei18n.T(ctx, "settings.profile_description") }</p>
		</header>
		@ProfileForm(props.Profile)
	</section>
	<section class="settings__section" aria-labelledby="password-title">
		<header class="settings__heading">
			<h2 id="password-title">{ officei18n.T(ctx, "settings.password") }</h2>
			<p>{ officei18n.T(ctx, "settings.password_description") }</p>
		</header>
		@PasswordForm(props.Password)
	</section>
}

// The confirmations keep a stable region, so a later failed submission can
// clear an outdated one out of band while it replaces only its form.
templ settingsNotices(notices []string, outOfBand bool) {
	<div
		id="settings-notices"
		class="settings__notices"
		if outOfBand {
			hx-swap-oob="morph"
		}
	>
		if len(notices) > 0 {
			<div class="notice" role="status">
				@components.Icon("check")
				<div class="notice__messages">
					for _, notice := range notices {
						<p>{ notice }</p>
					}
				</div>
			</div>
		}
	</div>
}

// SettingsFormFailure is the response to a failed in-page submission: the
// form with its errors, and no confirmation of an earlier change.
templ SettingsFormFailure(form templ.Component) {
	@form
	@settingsNotices(nil, true)
}

// ProfileForm carries the moment of the change it was built from, so saving
// it cannot overwrite a newer change. A changed email needs the current
// password, which its confirmation asks for; the names alone do not.
templ ProfileForm(props ProfileFormProps) {
	<form
		id={ ProfileFormID }
		class="form"
		method="post"
		action={ templ.URL(props.Action) }
		novalidate
		data-confirm-password="email"
		{ components.FormAttributes()... }
	>
		@components.FormAlert(props.Error)
		<input type="hidden" name="updated_at" value={ props.UpdatedAt }/>
		<div class="form__row">
			@components.TextInput(components.TextInputProps{
				ID:           "profile-first-name",
				Name:         "first_name",
				Type:         "text",
				Label:        officei18n.T(ctx, "fields.first_name"),
				Autocomplete: "given-name",
				Value:        props.FirstName,
				Required:     true,
				Error:        props.FieldErrors["first_name"],
			})
			@components.TextInput(components.TextInputProps{
				ID:           "profile-last-name",
				Name:         "last_name",
				Type:         "text",
				Label:        officei18n.T(ctx, "fields.last_name"),
				Autocomplete: "family-name",
				Value:        props.LastName,
				Required:     true,
				Error:        props.FieldErrors["last_name"],
			})
		</div>
		@components.TextInput(components.TextInputProps{
			ID:           "profile-email",
			Name:         "email",
			Type:         "email",
			Label:        officei18n.T(ctx, "fields.email"),
			Autocomplete: "email",
			Value:        props.Email,
			Required:     true,
			Error:        props.FieldErrors["email"],
		})
		<div class="form__submit">
			<button class="button" type="submit">{ officei18n.T(ctx, "settings.save_profile") }</button>
		</div>
		@ProfileConfirm(props)
	</form>
}

templ ProfileConfirm(props ProfileFormProps) {
	@passwordConfirm(ProfileConfirmID, props.Confirm, officei18n.T(ctx, "settings.confirm_email"), props.CancelURL)
}

// PasswordForm asks for the new password twice, then for the current one in
// its confirmation. Changing it signs out every other device.
templ PasswordForm(props PasswordFormProps) {
	<form
		id={ PasswordFormID }
		class="form"
		method="post"
		action={ templ.URL(props.Action) }
		novalidate
		data-confirm-password="always"
		{ components.FormAttributes()... }
	>
		@components.FormAlert(props.Error)
		@components.PasswordInput(components.TextInputProps{
			ID:           "password-new",
			Name:         "new_password",
			Label:        officei18n.T(ctx, "fields.new_password"),
			Autocomplete: "new-password",
			Required:     true,
			Hint:         officei18n.Count(ctx, "settings.password_hint", users.MinPasswordLength),
			Error:        props.FieldErrors["new_password"],
		})
		@components.PasswordInput(components.TextInputProps{
			ID:           "password-repeat",
			Name:         "new_password_repeat",
			Label:        officei18n.T(ctx, "fields.new_password_repeat"),
			Autocomplete: "new-password",
			Required:     true,
			Error:        props.FieldErrors["new_password_repeat"],
			Matches:      "new_password",
		})
		<div class="form__submit">
			<button class="button" type="submit">{ officei18n.T(ctx, "settings.change_password") }</button>
		</div>
		@PasswordConfirm(props)
	</form>
}

templ PasswordConfirm(props PasswordFormProps) {
	@passwordConfirm(PasswordConfirmID, props.Confirm, officei18n.T(ctx, "settings.confirm_password"), props.CancelURL)
}

// passwordConfirm belongs to its form, so confirming submits the form's
// fields together with the current password, which is never rendered back.
// Its submit button names the confirmation, so the server can tell an empty
// password from a submission that has not asked for one yet. Without
// JavaScript an open confirmation shows inline and Cancel reloads the
// settings; with JavaScript it is a modal and Cancel closes it.
templ passwordConfirm(id string, props ConfirmProps, description string, cancelURL string) {
	<dialog
		id={ id }
		class="confirm-dialog"
		aria-labelledby={ id + "-title" }
		aria-describedby={ id + "-description" }
		data-confirm-dialog
		if props.Open {
			open
		}
	>
		<div class="confirm-dialog__body">
			<header class="confirm-dialog__heading">
				<h2 id={ id + "-title" }>{ officei18n.T(ctx, "settings.confirm_title") }</h2>
				<p id={ id + "-description" }>{ description }</p>
			</header>
			@components.PasswordInput(components.TextInputProps{
				ID:           id + "-password",
				Name:         "current_password",
				Label:        officei18n.T(ctx, "fields.current_password"),
				Autocomplete: "current-password",
				Required:     true,
				Error:        props.Error,
			})
			<div class="confirm-dialog__actions">
				<a
					class="confirm-dialog__cancel"
					href={ templ.URL(cancelURL) }
					data-dialog-close
					{ components.NavigationAttributes()... }
				>{ officei18n.T(ctx, "common.cancel") }</a>
				<button class="button" type="submit" name="confirm" value="1" data-confirm-submit>
					{ officei18n.T(ctx, "common.confirm") }
				</button>
			</div>
		</div>
	</dialog>
}
