package layouts

import (
	officei18n "github.com/radynsade/faryengo/web/office/i18n"
	"github.com/radynsade/faryengo/web/office/templates/components"
)

// Key names the item's label and marks it active; Icon names its symbol.

type NavigationItem struct {
	Key  string
	Icon string
	Href string
}

// A narrow page, such as a form, keeps its content in the same narrow
// centered column as the standalone layout.

type DashboardProps struct {
	Title      string
	Active     string
	Navigation []NavigationItem
	TopBar     TopBarProps
	Narrow     bool
}

// Dashboard frames every page of a workspace with the top bar and the
// sidebar, which holds only the workspace's navigation. Links and forms
// inside it inherit the main region as their target, so navigation replaces
// only the page's main region. When the request already shows the dashboard,
// only the main region is rendered, together with out-of-band updates of the
// menu and the top bar's parts, which depend on the page.
//
// On narrow screens the sidebar becomes a drawer opened from the top bar;
// without JavaScript it stays above the content.
templ Dashboard(props DashboardProps) {
	{{ markDashboardRendered(ctx) }}
	if contentOnly(ctx) {
		@dashboardMain(props) {
			{ children... }
		}
		if props.TopBar.Workspace != nil {
			@topBarWorkspace(*props.TopBar.Workspace, true)
		}
		@dashboardMenu(props, true)
		@topBarActions(props.TopBar, true)
	} else {
		<div class="dashboard" hx-target={ "#" + ContentRegionID } data-dashboard { pageRegion(ctx)... }>
			<a class="skip-link" href={ templ.SafeURL("#" + ContentRegionID) }>{ officei18n.T(ctx, "navigation.skip") }</a>
			@topBar(props.TopBar, true)
			<div class="dashboard__backdrop" data-sidebar-close></div>
			<div class="dashboard__body">
				<aside id="dashboard-sidebar" class="sidebar">
					<div class="sidebar__head">
						@components.Brand(false)
						<button
							class="icon-button sidebar__close"
							type="button"
							aria-label={ officei18n.T(ctx, "dashboard.close_menu") }
							data-sidebar-close
						>
							@components.Icon("close")
						</button>
					</div>
					@dashboardMenu(props, false)
				</aside>
				@dashboardMain(props) {
					{ children... }
				}
			</div>
		</div>
	}
}

templ dashboardMain(props DashboardProps) {
	<main
		id={ ContentRegionID }
		class={ "dashboard__main", templ.KV("dashboard__main--narrow", props.Narrow) }
		tabindex="-1"
		aria-labelledby="page-title"
	>
		<header class="dashboard__header">
			<h1 id="page-title">{ props.Title }</h1>
		</header>
		<div class="dashboard__content">
			{ children... }
		</div>
	</main>
}

// The menu marks the active section, so every navigation updates it.
templ dashboardMenu(props DashboardProps, outOfBand bool) {
	<nav
		id="dashboard-menu"
		class="sidebar__nav"
		aria-label={ officei18n.T(ctx, "dashboard.navigation") }
		if outOfBand {
			hx-swap-oob="morph"
		}
	>
		<ul>
			for _, item := range props.Navigation {
				<li>
					<a
						class="sidebar__link"
						href={ templ.URL(item.Href) }
						if item.Key == props.Active {
							aria-current="page"
						}
						{ components.NavigationAttributes()... }
					>
						@components.Icon(item.Icon)
						<span>{ officei18n.T(ctx, "nav." + item.Key) }</span>
					</a>
				</li>
			}
		</ul>
	</nav>
}
