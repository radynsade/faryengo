package components

import (
	"strconv"
	"strings"

	"github.com/radynsade/faryengo/web/office/assets"
	officei18n "github.com/radynsade/faryengo/web/office/i18n"
)

type TextInputProps struct {
	ID           string
	Name         string
	Type         string
	Label        string
	Placeholder  string
	Autocomplete string
	Value        string
	Required     bool
	Hint         string
	Error        string
	// Matches names the field this one must repeat, such as a new password.
	Matches string
}

templ TextInput(props TextInputProps) {
	<div class="field">
		<label class="field__label" for={ props.ID }>{ props.Label }</label>
		<input
			class="field__input"
			id={ props.ID }
			name={ props.Name }
			type={ props.Type }
			placeholder={ props.Placeholder }
			autocomplete={ props.Autocomplete }
			value={ props.Value }
			required?={ props.Required }
			if props.Matches != "" {
				data-must-match={ props.Matches }
			}
			if props.Error != "" {
				aria-invalid="true"
			}
			if describedBy(props) != "" {
				aria-describedby={ describedBy(props) }
			}
		/>
		@fieldError(props)
	</div>
}

// PasswordInput adds a visibility toggle. The toggle carries both of its
// labels, so the script switches them without its own copy.
templ PasswordInput(props TextInputProps) {
	<div class="field">
		<label class="field__label" for={ props.ID }>{ props.Label }</label>
		<div class="field__control">
			<input
				class="field__input field__input--with-action"
				id={ props.ID }
				name={ props.Name }
				type="password"
				placeholder={ props.Placeholder }
				autocomplete={ props.Autocomplete }
				required?={ props.Required }
				if props.Matches != "" {
					data-must-match={ props.Matches }
				}
				if props.Error != "" {
					aria-invalid="true"
				}
				if describedBy(props) != "" {
					aria-describedby={ describedBy(props) }
				}
			/>
			<button
				class="field__action"
				type="button"
				aria-controls={ props.ID }
				aria-pressed="false"
				aria-label={ officei18n.T(ctx, "fields.show_password") }
				data-password-toggle
				data-label-show={ officei18n.T(ctx, "fields.show_password") }
				data-label-hide={ officei18n.T(ctx, "fields.hide_password") }
			>
				<svg class="icon field__action-show" width="18" height="18" aria-hidden="true"><use href={ assets.Icons + "#eye" }></use></svg>
				<svg class="icon field__action-hide" width="18" height="18" aria-hidden="true"><use href={ assets.Icons + "#eye-off" }></use></svg>
			</button>
		</div>
		@fieldError(props)
	</div>
}

type SelectOption struct {
	Value string
	Label string
}

type SelectProps struct {
	ID      string
	Name    string
	Label   string
	Value   string
	Options []SelectOption
	Error   string
}

// Select chooses one of a fixed set of values; the option matching Value
// starts selected.
templ Select(props SelectProps) {
	<div class="field">
		<label class="field__label" id={ props.ID + "-label" } for={ props.ID }>{ props.Label }</label>
		@SelectControl(SelectControlProps{
			ID:          props.ID,
			Name:        props.Name,
			Value:       props.Value,
			Options:     props.Options,
			LabelledBy:  props.ID + "-label",
			Invalid:     props.Error != "",
			DescribedBy: errorID(props.ID, props.Error),
		})
		if props.Error != "" {
			<p class="field__error" id={ props.ID + "-error" }>{ props.Error }</p>
		}
	</div>
}

type SelectControlProps struct {
	ID      string
	Name    string
	Value   string
	Options []SelectOption
	// Class is added to the control's wrapper.
	Class string
	// Exactly one of AriaLabel and LabelledBy names the control.
	AriaLabel   string
	LabelledBy  string
	Invalid     bool
	DescribedBy string
	// AutoSubmit submits the form as soon as the value changes.
	AutoSubmit bool
}

// SelectControl is a select whose options open as a styled list. The native
// select stays hidden; the script keeps it in sync with the list, so the form
// submits it.
templ SelectControl(props SelectControlProps) {
	<div class={ "select", props.Class } data-select>
		<select
			class="field__input field__input--select select__native"
			id={ props.ID }
			name={ props.Name }
			if props.AutoSubmit {
				data-auto-submit
			}
			if props.AriaLabel != "" {
				aria-label={ props.AriaLabel }
			}
			if props.Invalid {
				aria-invalid="true"
			}
			if props.DescribedBy != "" {
				aria-describedby={ props.DescribedBy }
			}
		>
			for _, option := range props.Options {
				<option value={ option.Value } selected?={ option.Value == props.Value }>{ option.Label }</option>
			}
		</select>
		<button
			class="field__input select__toggle"
			id={ props.ID + "-toggle" }
			type="button"
			aria-haspopup="listbox"
			aria-expanded="false"
			aria-controls={ props.ID + "-list" }
			if props.AriaLabel != "" {
				aria-label={ props.AriaLabel }
			} else {
				aria-labelledby={ props.LabelledBy + " " + props.ID + "-toggle" }
			}
			if props.Invalid {
				aria-invalid="true"
			}
			if props.DescribedBy != "" {
				aria-describedby={ props.DescribedBy }
			}
		>
			<span class="select__value">{ selectedLabel(props) }</span>
			@Icon("chevron-down")
		</button>
		<ul
			class="select__list"
			id={ props.ID + "-list" }
			role="listbox"
			if props.AriaLabel != "" {
				aria-label={ props.AriaLabel }
			} else {
				aria-labelledby={ props.LabelledBy }
			}
			hidden
		>
			for _, option := range props.Options {
				<li
					class="select__option"
					role="option"
					tabindex="-1"
					data-value={ option.Value }
					aria-selected={ strconv.FormatBool(option.Value == props.Value) }
				>
					<span>{ option.Label }</span>
					@Icon("check")
				</li>
			}
		</ul>
	</div>
}

func selectedLabel(props SelectControlProps) string {
	for _, option := range props.Options {
		if option.Value == props.Value {
			return option.Label
		}
	}

	if len(props.Options) > 0 {
		return props.Options[0].Label
	}

	return ""
}

func errorID(id, message string) string {
	if message == "" {
		return ""
	}

	return id + "-error"
}

// The hint stays while an error explains what went wrong.
templ fieldError(props TextInputProps) {
	if props.Hint != "" {
		<p class="field__hint" id={ props.ID + "-hint" }>{ props.Hint }</p>
	}
	if props.Error != "" {
		<p class="field__error" id={ props.ID + "-error" }>{ props.Error }</p>
	}
}

func describedBy(props TextInputProps) string {
	ids := make([]string, 0, 2)

	if props.Hint != "" {
		ids = append(ids, props.ID+"-hint")
	}

	if props.Error != "" {
		ids = append(ids, props.ID+"-error")
	}

	return strings.Join(ids, " ")
}

// FormAlert reports a problem with the whole form rather than one field.
templ FormAlert(message string) {
	if message != "" {
		<div class="form-alert" role="alert">
			@Icon("alert")
			<p>{ message }</p>
		</div>
	}
}
