package components

import (
	"strings"

	admini18n "github.com/radynsade/faryengo/web/admin/i18n"
)

const ConfirmDeleteID = "confirm-delete"

type ConfirmDeleteProps struct {
	Title   string
	Message string
	Action  string
	Errors  []string
}

// DeleteButton opens the shared confirmation dialog for one entity. The
// server renders the complete localized title, so the script only copies it.
templ DeleteButton(action, title, className, label string) {
	<button
		type="button"
		class={ className }
		aria-label={ label }
		aria-haspopup="dialog"
		aria-controls={ ConfirmDeleteID }
		data-confirm-delete={ ConfirmDeleteID }
		data-confirm-action={ action }
		data-confirm-title={ title }
	>
		{ children... }
	</button>
}

// ConfirmDelete is a self-contained dialog; a failed deletion replaces it
// with the same dialog showing the error.
templ ConfirmDelete(props ConfirmDeleteProps) {
	<dialog
		id={ ConfirmDeleteID }
		class="admin-dialog confirm-delete"
		role="alertdialog"
		aria-labelledby={ ConfirmDeleteID + "-title" }
		aria-describedby={ ConfirmDeleteID + "-message" }
		data-dialog
		if len(props.Errors) > 0 {
			data-dialog-open
		}
	>
		<button class="admin-dialog__close" type="button" aria-label={ admini18n.T(ctx, "actions.close") } data-dialog-close>
			<i class="ti ti-x" aria-hidden="true"></i>
		</button>
		<div class="confirm-delete__body">
			<div class="confirm-delete__header">
				<i class="ti ti-alert-triangle confirm-delete__icon" aria-hidden="true"></i>
				<h2 id={ ConfirmDeleteID + "-title" } class="confirm-delete__title" data-confirm-title>{ props.Title }</h2>
			</div>
			<p id={ ConfirmDeleteID + "-message" } class="confirm-delete__message">{ props.Message }</p>
			<p class="confirm-delete__error" role="alert" hidden?={ len(props.Errors) == 0 } data-confirm-error>{ strings.Join(props.Errors, " ") }</p>
		</div>
		<form
			class="confirm-delete__footer"
			method="post"
			action={ templ.URL(props.Action) }
			if props.Action != "" {
				hx-post={ props.Action }
			}
			hx-target={ "#" + ConfirmDeleteID }
			hx-swap="outerHTML"
			hx-push-url="false"
			hx-sync="this:drop"
			hx-disabled-elt="find button[type='submit']"
		>
			<input type="hidden" name="confirm" value="delete"/>
			<button class="button button--secondary" type="button" autofocus data-dialog-close>{ admini18n.T(ctx, "actions.cancel") }</button>
			<button class="button button--danger" type="submit">{ admini18n.T(ctx, "actions.delete") }</button>
		</form>
	</dialog>
}
