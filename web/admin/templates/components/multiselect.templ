package components

// MultiSelect keeps a native select as the form value and no-JavaScript fallback.
templ MultiSelect(id, name, label, placeholder string) {
	<div class="form-field multiselect" data-multiselect>
		<label class="form-field__label" id={ id + "-label" } for={ id }>{ label }</label>
		<select class="form-field__input multiselect__native" id={ id } name={ name } multiple>
			{ children... }
		</select>
		<div class="multiselect__widget" hidden>
			<div class="multiselect__control">
				<input
					class="form-field__input multiselect__input"
					id={ id + "-input" }
					type="text"
					placeholder={ placeholder }
					autocomplete="off"
					spellcheck="false"
					role="combobox"
					aria-autocomplete="list"
					aria-haspopup="listbox"
					aria-expanded="false"
					aria-labelledby={ id + "-label" }
					aria-controls={ id + "-options" }
				/>
				<span class="multiselect__count" hidden aria-hidden="true"></span>
				<div class="multiselect__dropdown" hidden>
					<ul class="multiselect__options" id={ id + "-options" } role="listbox" aria-multiselectable="true" aria-labelledby={ id + "-label" }></ul>
					<p class="multiselect__empty" hidden>No matching options.</p>
				</div>
			</div>
			<div class="multiselect__values"></div>
			<span class="visually-hidden multiselect__status" role="status" aria-live="polite"></span>
		</div>
	</div>
}
