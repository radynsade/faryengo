package components

import admini18n "github.com/radynsade/faryengo/web/admin/i18n"

templ SuccessDialog(messages []string) {
	if len(messages) > 0 {
		<dialog id="success-dialog" class="admin-dialog success-dialog" aria-labelledby="success-dialog-title" aria-describedby="success-dialog-message" data-dialog data-dialog-open data-success-dialog>
			<button class="admin-dialog__close" type="button" aria-label={ admini18n.T(ctx, "actions.close") } autofocus data-dialog-close>
				<i class="ti ti-x" aria-hidden="true"></i>
			</button>
			<div class="success-dialog__body">
				<i class="ti ti-circle-check success-dialog__icon" aria-hidden="true"></i>
				<h2 id="success-dialog-title" class="success-dialog__title">{ admini18n.T(ctx, "common.done") }</h2>
				<div id="success-dialog-message">
					for _, message := range messages {
						<p class="success-dialog__message">{ message }</p>
					}
				</div>
			</div>
		</dialog>
	}
}
