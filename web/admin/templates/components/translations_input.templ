package components

import admini18n "github.com/radynsade/faryengo/web/admin/i18n"

import "strconv"

type TranslationInputValue struct {
	Code     string
	Language string
	Value    string
	Errors   []string
}

type TranslationsInputProps struct {
	ID        string
	Name      string
	Label     string
	Language  string
	Help      string
	MaxLength int
	Values    []TranslationInputValue
	Errors    []string
}

func (props TranslationsInputProps) initialLanguage() string {
	var language string

	if len(props.Values) > 0 {
		language = props.Values[0].Code

		for _, field := range props.Values {
			if field.Code == props.Language {
				language = field.Code
			}
		}
	}

	// Show a failed translation immediately, including errors on inactive tabs.
	for _, field := range props.Values {
		if len(field.Errors) > 0 {
			language = field.Code
			break
		}
	}

	return language
}

func (props TranslationsInputProps) description(field TranslationInputValue) string {
	var help, groupErrors, fieldErrors string

	if props.Help != "" {
		help = props.ID + "-help"
	}

	if len(props.Errors) > 0 {
		groupErrors = props.ID + "-errors"
	}

	if len(field.Errors) > 0 {
		fieldErrors = props.ID + "-" + field.Code + "-errors"
	}

	return describedBy(help, groupErrors, fieldErrors)
}

// TranslationsInput renders the complete initial tab state for client hydration.
templ TranslationsInput(props TranslationsInputProps) {
	{{ initialLanguage := props.initialLanguage() }}
	<div class="translations-input" data-translations-input data-language={ initialLanguage }>
		<div class="translations-input__tabs" role="tablist" aria-label={ admini18n.T(ctx, "fields.languages", map[string]any{"Label": props.Label}) } hidden?={ len(props.Values) == 0 }>
			for _, field := range props.Values {
				<button
					class={ "translations-input__tab", templ.KV("translations-input__tab--invalid", len(field.Errors) > 0) }
					type="button"
					id={ props.ID + "-tab-" + field.Code }
					role="tab"
					aria-selected={ strconv.FormatBool(field.Code == initialLanguage) }
					tabindex={ map[bool]string{true: "0", false: "-1"}[field.Code == initialLanguage] }
					aria-controls={ props.ID + "-panel-" + field.Code }
					data-language={ field.Code }
					lang={ field.Code }
				>
					{ field.Language }
					if len(field.Errors) > 0 {
						<i class="ti ti-alert-circle" aria-hidden="true"></i>
					}
				</button>
			}
		</div>
		<div class="translations-input__panels">
			for _, field := range props.Values {
				<div
					class="translations-input__panel"
					id={ props.ID + "-panel-" + field.Code }
					data-language={ field.Code }
					role="tabpanel"
					aria-labelledby={ props.ID + "-tab-" + field.Code }
					hidden?={ field.Code != initialLanguage }
				>
					<label class={ "form-field", templ.KV("form-field--invalid", len(field.Errors) > 0 || len(props.Errors) > 0) } for={ props.ID + "-" + field.Code }>
						<span class="form-field__label">{ admini18n.T(ctx, "fields.translation", map[string]any{"Label": props.Label, "Language": field.Language}) }</span>
						<input
							class="form-field__input"
							id={ props.ID + "-" + field.Code }
							name={ props.Name + "[" + field.Code + "]" }
							value={ field.Value }
							lang={ field.Code }
							if props.description(field) != "" {
								aria-describedby={ props.description(field) }
							}
							if len(field.Errors) > 0 || len(props.Errors) > 0 {
								aria-invalid="true"
							}
							if props.MaxLength > 0 {
								maxlength={ strconv.Itoa(props.MaxLength) }
							}
						/>
					</label>
					@FieldMessages(props.ID+"-"+field.Code+"-errors", field.Errors)
				</div>
			}
		</div>
		@FieldMessages(props.ID+"-errors", props.Errors)
		if props.Help != "" {
			<p class="translations-input__help" id={ props.ID + "-help" }>{ props.Help }</p>
		}
	</div>
}
