package templates

// Brand is the shared admin wordmark. The symbol is decorative.
templ Brand() {
	<div class="brand" aria-label="Faryen">
		<svg class="brand__mark" width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
			<rect width="28" height="28" rx="7" fill="currentColor"></rect>
			<path d="M9 8.5H19V11H12V13.5H17.5V16H12V20H9V8.5Z" fill="white"></path>
		</svg>
		<span class="brand__name">Faryen</span>
	</div>
}
