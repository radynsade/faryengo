package layouts

import (
	"github.com/radynsade/faryengo/pkg/flashmsg"
	"github.com/radynsade/faryengo/web/admin/templates/components"
)

type PanelProps struct {
	Title string
	BasePath string
	ActiveSection string
	FirstName string
	LastName string
	Email string
}

// Panel wraps authenticated pages with navigation and the current user's identity.
templ Panel(props PanelProps) {
	<div id="page-content" class="panel-layout">
		<a class="panel-skip-link" href="#panel-main">Skip to content</a>
		<aside class="panel-sidebar" aria-label="Admin sidebar">
			<a class="panel-sidebar__brand" href={ templ.URL(props.BasePath) }>
				@components.Brand()
			</a>
			<section class="panel-sidebar__account" aria-label="Your account">
				<div class="panel-sidebar__identity">
					<p class="panel-sidebar__name">{ props.FirstName + " " + props.LastName }</p>
					<p class="panel-sidebar__email">{ props.Email }</p>
				</div>
				<form method="post" action={ templ.URL(props.BasePath + "/sign-out") }>
					<button class="panel-sidebar__sign-out" type="submit">
						<i class="ti ti-logout" aria-hidden="true"></i>
						Sign out
					</button>
				</form>
			</section>
			<div class="panel-sidebar__navigation">
				<p class="panel-sidebar__label">Workspace</p>
				<nav class="panel-menu" aria-label="Admin navigation">
					@components.PanelLink(props.BasePath + "/users", props.ActiveSection == "users") {
						<i class="ti ti-users" aria-hidden="true"></i>
						Users
					}
					@components.PanelLink(props.BasePath + "/roles", props.ActiveSection == "roles") {
						<i class="ti ti-shield-check" aria-hidden="true"></i>
						Roles
					}
				</nav>
			</div>
		</aside>
		<main id="panel-main" class="panel-main" tabindex="-1" aria-label={ props.Title }>
			@components.FlashMessages(flashmsg.FromContext(ctx), "notice")
			{ children... }
		</main>
	</div>
}
