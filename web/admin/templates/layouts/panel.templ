package layouts

import (
	"github.com/radynsade/faryengo/pkg/flashmsg"
	admini18n "github.com/radynsade/faryengo/web/admin/i18n"
	"github.com/radynsade/faryengo/web/admin/templates/components"
)

const (
	SectionHome  = ""
	SectionUsers = "users"
	SectionRoles = "roles"
)

type PanelProps struct {
	Title         string
	BasePath      string
	ActiveSection string
	FirstName     string
	LastName      string
	Email         string
	CanViewUsers  bool
	CanViewRoles  bool
}

// Panel wraps authenticated pages with navigation and the current user's
// identity. Sections the user may not view are left out of the navigation.
templ Panel(props PanelProps) {
	<div
		id="page-content"
		class="panel-layout"
		data-ui-language={ admini18n.Language(ctx) }
		data-navigation-error={ admini18n.T(ctx, "navigation.error") }
	>
		<a class="panel-skip-link" href="#panel-main">{ admini18n.T(ctx, "navigation.skip") }</a>
		<aside class="panel-sidebar" aria-label={ admini18n.T(ctx, "navigation.sidebar") }>
			<a class="panel-sidebar__brand" href={ templ.URL(props.BasePath) } { components.NavigationAttributes()... }>
				@components.Brand()
			</a>
			<section class="panel-sidebar__account" aria-label={ admini18n.T(ctx, "navigation.account") }>
				<div class="panel-sidebar__identity">
					<p class="panel-sidebar__name">{ admini18n.T(ctx, "common.full_name", map[string]any{"FirstName": props.FirstName, "LastName": props.LastName}) }</p>
					<p class="panel-sidebar__email">{ props.Email }</p>
				</div>
				<form method="post" action={ templ.URL(props.BasePath + "/sign-out") } { components.FormAttributes()... }>
					<button class="panel-sidebar__sign-out" type="submit">
						<i class="ti ti-logout" aria-hidden="true"></i>
						{ admini18n.T(ctx, "actions.sign_out") }
					</button>
				</form>
			</section>
			<div class="panel-sidebar__navigation">
				<p class="panel-sidebar__label">{ admini18n.T(ctx, "common.workspace") }</p>
				<nav class="panel-menu" aria-label={ admini18n.T(ctx, "navigation.menu") }>
					if props.CanViewUsers {
						@components.PanelLink(props.BasePath+"/users", props.ActiveSection == SectionUsers) {
							<i class="ti ti-users" aria-hidden="true"></i>
							{ admini18n.T(ctx, "navigation.users") }
						}
					}
					if props.CanViewRoles {
						@components.PanelLink(props.BasePath+"/roles", props.ActiveSection == SectionRoles) {
							<i class="ti ti-shield-check" aria-hidden="true"></i>
							{ admini18n.T(ctx, "navigation.roles") }
						}
					}
				</nav>
			</div>
			<div class="panel-sidebar__languages">
				@components.LanguageSwitcher()
			</div>
		</aside>
		<main id="panel-main" class="panel-main" tabindex="-1" aria-label={ props.Title }>
			@components.FlashMessages(flashmsg.FromContext(ctx), "notice")
			{ children... }
		</main>
	</div>
}
