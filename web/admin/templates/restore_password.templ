package templates

// RestorePassword presents the email recovery page without submission behavior.
templ RestorePassword() {
	@AuthLayout("Restore password", "Enter your email address to reset your password.") {
		<div class="form-stack">
			@TextInput(TextInputProps{
				ID: "email",
				Name: "email",
				Type: "email",
				Label: "Email address",
				Placeholder: "you@example.com",
				Autocomplete: "email",
			})
			@PrimaryButton("button") {
				Send reset link
			}
		</div>
		<p class="auth-panel__footer">
			@PageLink("sign-in") {
				Back to sign in
			}
		</p>
	}
}
