package pages

import (
	"github.com/radynsade/faryengo/internal/security"
	"github.com/radynsade/faryengo/web/admin/templates/components"
	"github.com/radynsade/faryengo/web/admin/templates/layouts"
	"strconv"
)

templ Roles(props RoleListProps) {
	@layouts.Panel(props.Panel) {
		@components.ConfirmDelete(roleDeleteDialog("", "", nil))
		<div class="role-list">
			<div class="list-toolbar">
				@components.ActionLink(props.Panel.BasePath+"/roles/create", "button button--primary button--compact", "Create role") {
					<i class="ti ti-plus" aria-hidden="true"></i>
					Create
				}
				<div class="list-toolbar__controls">
					<span class="role-total">Total found: { strconv.Itoa(props.Page.Total) }</span>
					<details class="filter-menu role-filters" open?={ props.InvalidQuery }>
						<summary class="button button--secondary button--compact">
							<i class="ti ti-filter" aria-hidden="true"></i>
							Filter
							if props.Query.Filters.Count() > 0 {
								<span class="badge">{ strconv.Itoa(props.Query.Filters.Count()) }</span>
							}
						</summary>
						<form
							class="filter-menu__form form-stack"
							method="get"
							action={ templ.URL(props.Panel.BasePath + "/roles") }
							hx-get={ props.Panel.BasePath + "/roles" }
							hx-target="#page-content"
							hx-swap="outerHTML show:none"
							hx-push-url="true"
							hx-sync="body:replace"
						>
							<input type="hidden" name="sort" value={ string(props.Query.Sort) }/>
							<input type="hidden" name="order" value={ map[bool]string{false: "asc", true: "desc"}[props.Query.Descending] }/>
							<input type="hidden" name="size" value={ strconv.Itoa(props.Query.PageSize) }/>
							<label class="form-field">
								<span class="form-field__label">UUID contains</span>
								<input class="form-field__input" name="uuid" value={ props.Query.Filters.IDLike } maxlength="100"/>
							</label>
							<label class="form-field">
								<span class="form-field__label">Name contains</span>
								<input class="form-field__input" name="name" value={ props.Query.Filters.NameLike } maxlength="500"/>
							</label>
							@RolePermissions("role-filter-permissions", "Permissions (all selected)", props.Permissions)
							<label class="form-field">
								<span class="form-field__label">Super role</span>
								<select class="form-field__input" name="super">
									<option value="" selected?={ props.Query.Filters.IsSuper == nil }>Any</option>
									<option value="true" selected?={ props.Query.Filters.IsSuper != nil && *props.Query.Filters.IsSuper }>Yes</option>
									<option value="false" selected?={ props.Query.Filters.IsSuper != nil && !*props.Query.Filters.IsSuper }>No</option>
								</select>
							</label>
							<div class="action-group">
								<button class="button button--primary button--compact" type="submit">Apply filters</button>
								@components.ActionLink(props.Panel.BasePath+"/roles", "button button--secondary button--compact", "Reset filters") {
									Reset
								}
							</div>
						</form>
					</details>
					<nav class="pagination" aria-label="Roles pages">
						if props.Page.Page > 1 {
							@components.ActionLink(props.URL(1, props.Query.Sort, props.Query.Descending), "icon-button", "First page") {
								<i class="ti ti-chevrons-left" aria-hidden="true"></i>
							}
							@components.ActionLink(props.URL(props.Page.Page-1, props.Query.Sort, props.Query.Descending), "icon-button", "Previous page") {
								<i class="ti ti-chevron-left" aria-hidden="true"></i>
							}
						} else {
							<span class="icon-button" aria-disabled="true"><i class="ti ti-chevrons-left" aria-hidden="true"></i></span>
							<span class="icon-button" aria-disabled="true"><i class="ti ti-chevron-left" aria-hidden="true"></i></span>
						}
						<span class="pagination__current">{ strconv.Itoa(props.Page.Page) } / { strconv.Itoa(props.Page.Pages()) }</span>
						if props.Page.Page < props.Page.Pages() {
							@components.ActionLink(props.URL(props.Page.Page+1, props.Query.Sort, props.Query.Descending), "icon-button", "Next page") {
								<i class="ti ti-chevron-right" aria-hidden="true"></i>
							}
							@components.ActionLink(props.URL(props.Page.Pages(), props.Query.Sort, props.Query.Descending), "icon-button", "Last page") {
								<i class="ti ti-chevrons-right" aria-hidden="true"></i>
							}
						} else {
							<span class="icon-button" aria-disabled="true"><i class="ti ti-chevron-right" aria-hidden="true"></i></span>
							<span class="icon-button" aria-disabled="true"><i class="ti ti-chevrons-right" aria-hidden="true"></i></span>
						}
					</nav>
				</div>
			</div>
			<div class="data-table-scroll" tabindex="0" role="region" aria-label="Roles table">
				<table class="data-table">
					<caption class="visually-hidden">Roles and their permissions</caption>
					<thead>
						<tr>
							<th scope="col" aria-sort={ props.SortDirection(security.RoleSortID) }>
								@RoleSortLink(props, security.RoleSortID, "UUID")
							</th>
							<th scope="col" aria-sort={ props.SortDirection(security.RoleSortName) }>
								@RoleSortLink(props, security.RoleSortName, "Name")
							</th>
							<th scope="col" aria-sort={ props.SortDirection(security.RoleSortSuper) }>
								@RoleSortLink(props, security.RoleSortSuper, "Super")
							</th>
							<th scope="col">Permissions</th>
							<th scope="col" class="data-table__actions"><span class="visually-hidden">Actions</span></th>
						</tr>
					</thead>
					<tbody>
						for _, row := range props.Rows {
							<tr>
								<td class="role-table__uuid">{ row.ID }</td>
								<td>
									@components.ActionLink(props.Panel.BasePath+"/roles/"+row.ID+"/view", "text-link", "View "+row.Name) {
										{ row.Name }
									}
									if row.Current {
										<span class="badge">Your role</span>
									}
								</td>
								<td>
									@RoleSuper(row.IsSuper)
								</td>
								<td>
									<div class="tag-list">
										if row.IsSuper {
											<span class="badge">All permissions</span>
										} else {
											for _, permission := range row.Permissions {
												<span class="badge">{ permission }</span>
											}
											if len(row.Permissions) == 0 {
												<span class="role-muted">None</span>
											}
										}
									</div>
								</td>
								<td class="data-table__actions">
									<div class="action-group">
										@components.ActionLink(props.Panel.BasePath+"/roles/"+row.ID+"/view", "icon-button", "View "+row.Name) {
											<i class="ti ti-eye" aria-hidden="true"></i>
										}
										@components.ActionLink(props.Panel.BasePath+"/roles/"+row.ID+"/edit", "icon-button", "Edit "+row.Name) {
											<i class="ti ti-pencil" aria-hidden="true"></i>
										}
										@components.DeleteButton("confirm-delete", props.Panel.BasePath+"/roles/"+row.ID+"/delete", row.Name, "icon-button icon-button--danger", "Delete "+row.Name) {
											<i class="ti ti-trash" aria-hidden="true"></i>
										}
									</div>
								</td>
							</tr>
						}
						if len(props.Rows) == 0 {
							<tr><td colspan="5" class="data-table__empty">No roles found. Try changing or resetting your filters.</td></tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	}
}

templ RoleSortLink(props RoleListProps, sort security.RoleSort, label string) {
	@components.ActionLink(props.SortURL(sort), "table-sort", "Sort by "+label) {
		{ label }
		if props.Query.Sort == sort {
			if props.Query.Descending {
				<i class="ti ti-arrow-down" aria-hidden="true"></i>
			} else {
				<i class="ti ti-arrow-up" aria-hidden="true"></i>
			}
		}
	}
}

templ RolePermissions(id, label string, options []PermissionOption) {
	@components.MultiSelect(id, "permissions", label, "Select permissions") {
		for _, option := range options {
			<option value={ string(option.Value) } selected?={ option.Selected }>{ option.Label }</option>
		}
	}
}

templ RoleSuper(isSuper bool) {
	if isSuper {
		<span class="badge">Yes</span>
	} else {
		<span class="badge badge--negative">No</span>
	}
}

templ RoleForm(props RoleFormProps) {
	@layouts.Panel(props.Panel) {
		<div class="panel-page">
			<div class="role-editor card">
				@components.PageLink(props.Panel.BasePath + "/roles") {
					<i class="ti ti-arrow-left" aria-hidden="true"></i>
					Roles
				}
				<h1>{ props.Title }</h1>
				<form class="form-stack" method="post" action={ templ.URL(props.Action) }>
					@components.TranslationsInput(props.NameTranslations)
					<label class="form-checkbox"><input type="checkbox" name="is_super" value="1" checked?={ props.IsSuper }/>Super role (grants all permissions)</label>
					@RolePermissions("role-permissions", "Permissions", props.Permissions)
					<div class="action-group">
						<button class="button button--primary" type="submit">
							<i class="ti ti-device-floppy" aria-hidden="true"></i>
							if props.ID == "" {
								Create role
							} else {
								Save changes
							}
						</button>
						@components.ActionLink(props.Panel.BasePath+"/roles", "button button--secondary", "Cancel") {
							Cancel
						}
					</div>
				</form>
			</div>
		</div>
	}
}

templ RoleView(props RoleViewProps) {
	@layouts.Panel(props.Panel) {
		@components.ConfirmDelete(roleDeleteDialog(props.Panel.BasePath+"/roles/"+props.Role.ID+"/delete", props.Role.Name, props.DeleteErrors))
		<div class="panel-page">
			<section class="role-editor card">
				@components.PageLink(props.Panel.BasePath + "/roles") {
					<i class="ti ti-arrow-left" aria-hidden="true"></i>
					Roles
				}
				<h1>{ props.Role.Name }</h1>
				<dl class="details-list">
					<dt>UUID</dt>
					<dd class="details-list__uuid">{ props.Role.ID }</dd>
					for _, name := range props.Names {
						<dt>Name ({ name.Label })</dt>
						<dd>{ name.Value }</dd>
					}
					<dt>Super role</dt>
					<dd>
						@RoleSuper(props.Role.IsSuper)
					</dd>
					<dt>Permissions</dt>
					<dd>
						if props.Role.IsSuper {
							All permissions
						} else if len(props.Role.Permissions) == 0 {
							None
						} else {
							<ul class="details-list__permissions">
								for _, permission := range props.Role.Permissions {
									<li>{ permission }</li>
								}
							</ul>
						}
					</dd>
				</dl>
				<div class="action-group">
					@components.ActionLink(props.Panel.BasePath+"/roles/"+props.Role.ID+"/edit", "button button--primary", "Edit role") {
						<i class="ti ti-pencil" aria-hidden="true"></i>
						Edit role
					}
					@components.DeleteButton("confirm-delete", props.Panel.BasePath+"/roles/"+props.Role.ID+"/delete", props.Role.Name, "button button--danger", "Delete role") {
						<i class="ti ti-trash" aria-hidden="true"></i>
						Delete role
					}
				</div>
			</section>
		</div>
	}
}
