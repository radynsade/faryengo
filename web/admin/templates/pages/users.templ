package pages

import (
	"github.com/radynsade/faryengo/internal/users"
	admini18n "github.com/radynsade/faryengo/web/admin/i18n"
	"github.com/radynsade/faryengo/web/admin/templates/components"
	"github.com/radynsade/faryengo/web/admin/templates/layouts"
	"strconv"
)

templ Users(props UserListProps) {
	@layouts.Panel(props.Panel) {
		if props.CanManage {
			@components.ConfirmDelete(UserDeleteDialog(ctx, "", "", nil))
		}
		@UsersTable(props)
	}
}

templ UsersTable(props UserListProps) {
	<div id="users-list-table" class="user-list" aria-busy={ strconv.FormatBool(props.Loading) }>
		<div class="list-toolbar">
			if props.CanManage {
				@components.ActionLink(props.Panel.BasePath+"/users/create", "button button--primary button--compact", admini18n.T(ctx, "users.create")) {
					<i class="ti ti-plus" aria-hidden="true"></i>
					{ admini18n.T(ctx, "actions.create") }
				}
			}
			<div class="list-toolbar__controls">
				<span class="user-total">
					if props.Loading {
						{ admini18n.T(ctx, "common.total_unknown") }
					} else {
						{ admini18n.Count(ctx, "common.total_found", props.Total) }
					}
				</span>
				<details class="filter-menu user-filters" open?={ props.InvalidQuery }>
					<summary class="button button--secondary button--compact">
						<i class="ti ti-filter" aria-hidden="true"></i>
						{ admini18n.T(ctx, "actions.filter") }
						if props.Query.Filter.Count() > 0 {
							<span class="badge">{ strconv.Itoa(props.Query.Filter.Count()) }</span>
						}
					</summary>
					<form
						class="filter-menu__form form-stack"
						method="get"
						action={ templ.URL(props.Panel.BasePath + "/users") }
						hx-get={ props.Panel.BasePath + "/users" }
						hx-swap="morph:outerHTML show:none"
						hx-push-url="true"
						hx-sync="body:replace"
					>
						<input type="hidden" name="sort" value={ string(props.Query.SortBy) }/>
						<input type="hidden" name="order" value={ SortOrderValue(props.Query.SortOrder) }/>
						<input type="hidden" name="size" value={ strconv.FormatUint(uint64(props.Query.Limit), 10) }/>
						@components.TextInput(components.TextInputProps{
							ID: "user-filter-uuid", Name: "uuid", Type: "text", Label: admini18n.T(ctx, "fields.uuid_contains"),
							Value: props.Query.Filter.IDLike, MaxLength: users.MaxUserFilterIDLikeLength, Errors: props.FieldErrors["uuid"],
						})
						@components.TextInput(components.TextInputProps{
							ID: "user-filter-name", Name: "name", Type: "text", Label: admini18n.T(ctx, "fields.full_name_contains"),
							Value: props.Query.Filter.NameLike, MaxLength: users.MaxUserFilterNameLikeLength, Errors: props.FieldErrors["name"],
						})
						@components.TextInput(components.TextInputProps{
							ID: "user-filter-email", Name: "email", Type: "text", Label: admini18n.T(ctx, "fields.email_contains"),
							Value: props.Query.Filter.EmailLike, MaxLength: users.MaxUserFilterEmailLikeLength, Errors: props.FieldErrors["email"],
						})
						@UserRoleSelect("user-filter-role", admini18n.T(ctx, "fields.role"), props.Roles, true, false, props.FieldErrors["role"])
						<div class="action-group">
							<button class="button button--primary button--compact" type="submit">{ admini18n.T(ctx, "actions.apply_filters") }</button>
							@components.ActionLink(props.Panel.BasePath+"/users", "button button--secondary button--compact", admini18n.T(ctx, "actions.reset_filters")) {
								{ admini18n.T(ctx, "actions.reset") }
							}
						</div>
					</form>
				</details>
				<nav class="pagination" aria-label={ admini18n.T(ctx, "pagination.users") }>
					if !props.Loading && props.Query.Page > 1 {
						@components.ActionLink(props.URL(1, props.Query.SortBy, props.Query.SortOrder), "icon-button", admini18n.T(ctx, "pagination.first")) {
							<i class="ti ti-chevrons-left" aria-hidden="true"></i>
						}
						@components.ActionLink(props.URL(int(props.Query.Page)-1, props.Query.SortBy, props.Query.SortOrder), "icon-button", admini18n.T(ctx, "pagination.previous")) {
							<i class="ti ti-chevron-left" aria-hidden="true"></i>
						}
					} else {
						<span class="icon-button" aria-disabled="true"><i class="ti ti-chevrons-left" aria-hidden="true"></i></span>
						<span class="icon-button" aria-disabled="true"><i class="ti ti-chevron-left" aria-hidden="true"></i></span>
					}
					<span class="pagination__current">
						if props.Loading {
							{ admini18n.T(ctx, "pagination.current_unknown", map[string]any{"Page": props.Query.Page}) }
						} else {
							{ admini18n.T(ctx, "pagination.current", map[string]any{"Page": props.Query.Page, "Pages": props.Pages()}) }
						}
					</span>
					if !props.Loading && int(props.Query.Page) < props.Pages() {
						@components.ActionLink(props.URL(int(props.Query.Page)+1, props.Query.SortBy, props.Query.SortOrder), "icon-button", admini18n.T(ctx, "pagination.next")) {
							<i class="ti ti-chevron-right" aria-hidden="true"></i>
						}
						@components.ActionLink(props.URL(props.Pages(), props.Query.SortBy, props.Query.SortOrder), "icon-button", admini18n.T(ctx, "pagination.last")) {
							<i class="ti ti-chevrons-right" aria-hidden="true"></i>
						}
					} else {
						<span class="icon-button" aria-disabled="true"><i class="ti ti-chevron-right" aria-hidden="true"></i></span>
						<span class="icon-button" aria-disabled="true"><i class="ti ti-chevrons-right" aria-hidden="true"></i></span>
					}
				</nav>
			</div>
		</div>
		<div class="data-table-scroll" tabindex="0" role="region" aria-label={ admini18n.T(ctx, "users.table") }>
			<table class={ "data-table data-table--fixed user-table", templ.KV("user-table--manage", props.CanManage) }>
				<caption class="visually-hidden">{ admini18n.T(ctx, "users.caption") }</caption>
				<colgroup>
					<col class="user-table__col--uuid"/>
					<col class="user-table__col--name"/>
					<col class="user-table__col--email"/>
					<col class="user-table__col--phone"/>
					<col class="user-table__col--role"/>
					<col class="user-table__col--created"/>
					<col class="user-table__col--actions"/>
				</colgroup>
				<thead>
					<tr>
						<th scope="col" aria-sort={ props.SortDirection(users.UserSortID) }>
							@UserSortLink(props, users.UserSortID, admini18n.T(ctx, "fields.uuid"))
						</th>
						<th scope="col" aria-sort={ props.SortDirection(users.UserSortFirstName) }>
							@UserSortLink(props, users.UserSortFirstName, admini18n.T(ctx, "fields.full_name"))
						</th>
						<th scope="col" aria-sort={ props.SortDirection(users.UserSortEmail) }>
							@UserSortLink(props, users.UserSortEmail, admini18n.T(ctx, "fields.email"))
						</th>
						<th scope="col">{ admini18n.T(ctx, "fields.phone") }</th>
						<th scope="col">{ admini18n.T(ctx, "fields.role") }</th>
						<th scope="col" aria-sort={ props.SortDirection(users.UserSortCreatedAt) }>
							@UserSortLink(props, users.UserSortCreatedAt, admini18n.T(ctx, "fields.created_at"))
						</th>
						<th scope="col" class="data-table__actions"><span class="visually-hidden">{ admini18n.T(ctx, "fields.actions") }</span></th>
					</tr>
				</thead>
				<tbody>
					if props.Loading {
						<tr>
							<td colspan="7" class="data-table__loading">
								<div
									role="status"
									hx-get={ props.TableURL() }
									hx-trigger="load delay:100ms, htmx:afterSettle from:body delay:100ms"
									hx-target="#users-list-table"
									hx-swap="outerHTML"
									hx-sync="body:abort"
								>
									<span class="data-table__spinner" aria-hidden="true"></span>
									<span class="visually-hidden">{ admini18n.T(ctx, "users.loading") }</span>
								</div>
								<noscript>
									<a class="text-link" href={ templ.URL(props.TableURL()) }>{ admini18n.T(ctx, "actions.list") }</a>
								</noscript>
							</td>
						</tr>
					}
					for _, row := range props.Rows {
						<tr id={ "user-" + row.ID }>
							<td class="user-table__uuid">{ row.ID }</td>
							<td>
								<div class="tag-list">
									@components.ActionLink(props.Panel.BasePath+"/users/"+row.ID+"/view", "text-link", admini18n.T(ctx, "actions.view_named", map[string]any{"Name": row.FullName(ctx)})) {
										{ row.FullName(ctx) }
									}
									if row.Current {
										<span class="badge">{ admini18n.T(ctx, "users.you") }</span>
									}
								</div>
							</td>
							<td class="user-table__text">{ row.Email }</td>
							<td class="user-table__text">{ row.Phone }</td>
							<td>
								@UserRole(props.Panel.BasePath, row, props.CanViewRoles)
							</td>
							<td class="user-table__text user-muted">{ row.CreatedAt }</td>
							<td class="data-table__actions">
								<div class="action-group">
									@components.ActionLink(props.Panel.BasePath+"/users/"+row.ID+"/view", "icon-button", admini18n.T(ctx, "actions.view_named", map[string]any{"Name": row.FullName(ctx)})) {
										<i class="ti ti-eye" aria-hidden="true"></i>
									}
									if props.CanManage {
										@components.ActionLink(props.Panel.BasePath+"/users/"+row.ID+"/edit", "icon-button", admini18n.T(ctx, "actions.edit_named", map[string]any{"Name": row.FullName(ctx)})) {
											<i class="ti ti-pencil" aria-hidden="true"></i>
										}
										if !row.Current {
											@components.DeleteButton(props.Panel.BasePath+"/users/"+row.ID+"/delete", admini18n.T(ctx, "users.delete_title", map[string]any{"Name": row.FullName(ctx)}), "icon-button icon-button--danger", admini18n.T(ctx, "actions.delete_named", map[string]any{"Name": row.FullName(ctx)})) {
												<i class="ti ti-trash" aria-hidden="true"></i>
											}
										}
									}
								</div>
							</td>
						</tr>
					}
					if len(props.Errors) > 0 {
						<tr>
							<td colspan="7" class="data-table__empty">
								for _, message := range props.Errors {
									<p class="notice notice--error" role="alert">{ message }</p>
								}
								@components.ActionLink(props.CurrentURL(), "button button--secondary button--compact", admini18n.T(ctx, "actions.retry")) {
									{ admini18n.T(ctx, "actions.retry") }
								}
							</td>
						</tr>
					}
					if !props.Loading && !props.InvalidQuery && len(props.Errors) == 0 && len(props.Rows) == 0 {
						<tr><td colspan="7" class="data-table__empty">{ admini18n.T(ctx, "users.empty") }</td></tr>
					}
				</tbody>
			</table>
		</div>
	</div>
}

templ UserSortLink(props UserListProps, sort users.UserSort, label string) {
	@components.ActionLink(props.SortURL(sort), "table-sort", admini18n.T(ctx, "actions.sort_by", map[string]any{"Label": label})) {
		{ label }
		if props.Query.SortBy == sort {
			if props.Query.SortOrder.IsDesc() {
				<i class="ti ti-arrow-down" aria-hidden="true"></i>
			} else {
				<i class="ti ti-arrow-up" aria-hidden="true"></i>
			}
		}
	}
}

// UserRole links to the Role only for users who may view it.
templ UserRole(basePath string, row UserRow, canViewRoles bool) {
	if canViewRoles {
		@components.ActionLink(basePath+"/roles/"+row.RoleID+"/view", "text-link", admini18n.T(ctx, "actions.view_named", map[string]any{"Name": row.RoleName})) {
			{ row.RoleName }
		}
	} else {
		{ row.RoleName }
	}
}

// UserRoleSelect is a native role choice. A filter offers "any role"; a form
// requires a choice and starts with an unselectable prompt.
templ UserRoleSelect(id, label string, options []RoleOption, filter bool, required bool, errors []string) {
	<div class={ "form-field", templ.KV("form-field--invalid", len(errors) > 0) }>
		<label class="form-field__label" for={ id }>{ label }</label>
		<select
			class="form-field__input"
			id={ id }
			name="role"
			required?={ required }
			if len(errors) > 0 {
				aria-invalid="true"
				aria-describedby={ id + "-errors" }
			}
		>
			if filter {
				<option value="" selected?={ !hasSelectedRole(options) }>{ admini18n.T(ctx, "common.any") }</option>
			} else {
				<option value="" disabled selected?={ !hasSelectedRole(options) }>{ admini18n.T(ctx, "fields.select_role") }</option>
			}
			for _, option := range options {
				<option value={ option.Value } selected?={ option.Selected }>{ option.Label }</option>
			}
		</select>
		@components.FieldMessages(id+"-errors", errors)
	</div>
}

templ UserForm(props UserFormProps) {
	@layouts.Panel(props.Panel) {
		if props.ID != "" && !props.Current {
			@components.ConfirmDelete(UserDeleteDialog(ctx, props.Panel.BasePath+"/users/"+props.ID+"/delete", props.Name, nil))
		}
		<div class="panel-page">
			<div class="panel-page__content">
				@components.PageTitle(props.Title, []components.BreadcrumbItem{
					{Label: admini18n.T(ctx, "common.admin"), Href: props.Panel.BasePath},
					{Label: admini18n.T(ctx, "navigation.users"), Href: props.Panel.BasePath + "/users"},
					{Label: props.Title},
				})
				@UserFieldsForm(props)
			</div>
		</div>
	}
}

// UserFieldsForm shares the field layout between creation and editing. It is
// also the region a failed in-page submission replaces, so form-wide errors
// render inside it, below the toolbar. The password field is always empty.
templ UserFieldsForm(props UserFormProps) {
	<section id={ UserFormID } class="user-form" aria-labelledby="page-heading">
		<form method="post" action={ templ.URL(props.Action) } { components.FormAttributes()... }>
			<header class="list-toolbar">
				<div class="action-group">
					<button class="button button--primary button--compact" type="submit">
						<i class="ti ti-device-floppy" aria-hidden="true"></i>
						if props.ID == "" {
							{ admini18n.T(ctx, "users.create") }
						} else {
							{ admini18n.T(ctx, "actions.save") }
						}
					</button>
					if props.ID != "" {
						@components.ActionLink(props.Panel.BasePath+"/users/"+props.ID+"/view", "button button--secondary button--compact", admini18n.T(ctx, "actions.view")) {
							<i class="ti ti-eye" aria-hidden="true"></i>
							{ admini18n.T(ctx, "actions.view") }
						}
					}
					@components.ActionLink(props.Panel.BasePath+"/users", "button button--secondary button--compact", admini18n.T(ctx, "actions.list")) {
						<i class="ti ti-list" aria-hidden="true"></i>
						{ admini18n.T(ctx, "actions.list") }
					}
				</div>
				if props.ID != "" && !props.Current {
					@components.DeleteButton(props.Panel.BasePath+"/users/"+props.ID+"/delete", admini18n.T(ctx, "users.delete_title", map[string]any{"Name": props.Name}), "icon-button icon-button--danger", admini18n.T(ctx, "users.delete")) {
						<i class="ti ti-trash" aria-hidden="true"></i>
					}
				}
			</header>
			for _, message := range props.Errors {
				<p class="notice notice--error" role="alert">{ message }</p>
			}
			if props.ID != "" {
				<input type="hidden" name="updated_at" value={ props.UpdatedAt }/>
			}
			<div class="user-form__fields">
				<div class="user-form__row">
					<div class="user-form__field">
						@components.TextInput(components.TextInputProps{
							ID: "user-first-name", Name: "first_name", Type: "text", Label: admini18n.T(ctx, "fields.first_name"),
							Autocomplete: "off", Value: props.FirstName, Required: true, MaxLength: users.MaxFirstNameLength,
							Errors: props.FieldErrors["first_name"],
						})
					</div>
					<div class="user-form__field">
						@components.TextInput(components.TextInputProps{
							ID: "user-last-name", Name: "last_name", Type: "text", Label: admini18n.T(ctx, "fields.last_name"),
							Autocomplete: "off", Value: props.LastName, Required: true, MaxLength: users.MaxLastNameLength,
							Errors: props.FieldErrors["last_name"],
						})
					</div>
				</div>
				<div class="user-form__row">
					<div class="user-form__field">
						@components.TextInput(components.TextInputProps{
							ID: "user-email", Name: "email", Type: "email", Label: admini18n.T(ctx, "fields.email"),
							Placeholder: admini18n.T(ctx, "fields.email_placeholder"), Autocomplete: "off", Value: props.Email,
							Required: true, MaxLength: 254, Errors: props.FieldErrors["email"],
						})
					</div>
					<div class="user-form__field">
						@components.TextInput(components.TextInputProps{
							ID: "user-phone", Name: "phone", Type: "tel", Label: admini18n.T(ctx, "fields.phone"),
							Placeholder: admini18n.T(ctx, "fields.phone_placeholder"), Help: admini18n.T(ctx, "users.phone_help"),
							Autocomplete: "off", Value: props.Phone, Required: true, MaxLength: 16, Errors: props.FieldErrors["phone"],
						})
					</div>
				</div>
				<div class="user-form__row">
					<div class="user-form__field">
						@UserRoleSelect("user-role", admini18n.T(ctx, "fields.role"), props.Roles, false, true, props.FieldErrors["role"])
					</div>
					<div class="user-form__field">
						if props.ID == "" {
							@components.TextInput(components.TextInputProps{
								ID: "user-password", Name: "password", Type: "password", Label: admini18n.T(ctx, "fields.password"),
								Autocomplete: "new-password", Help: admini18n.Count(ctx, "users.password_help", users.MinPasswordLength),
								Required: true, Errors: props.FieldErrors["password"],
							})
						} else {
							@components.TextInput(components.TextInputProps{
								ID: "user-password", Name: "password", Type: "password", Label: admini18n.T(ctx, "fields.new_password"),
								Autocomplete: "new-password", Help: admini18n.T(ctx, "users.password_keep_help"),
								Errors: props.FieldErrors["password"],
							})
						}
					</div>
				</div>
			</div>
		</form>
	</section>
}

templ UserView(props UserViewProps) {
	@layouts.Panel(props.Panel) {
		if props.CanManage && !props.User.Current {
			@components.ConfirmDelete(UserDeleteDialog(ctx, props.Panel.BasePath+"/users/"+props.User.ID+"/delete", props.User.FullName(ctx), props.DeleteErrors))
		}
		<div class="panel-page">
			<div class="panel-page__content">
				@components.PageTitle(props.User.FullName(ctx), []components.BreadcrumbItem{
					{Label: admini18n.T(ctx, "common.admin"), Href: props.Panel.BasePath},
					{Label: admini18n.T(ctx, "navigation.users"), Href: props.Panel.BasePath + "/users"},
					{Label: props.User.FullName(ctx)},
				})
				<section class="user-view" aria-labelledby="page-heading">
					<header class="list-toolbar">
						<div class="action-group">
							if props.CanManage {
								@components.ActionLink(props.Panel.BasePath+"/users/"+props.User.ID+"/edit", "button button--primary button--compact", admini18n.T(ctx, "users.edit")) {
									<i class="ti ti-pencil" aria-hidden="true"></i>
									{ admini18n.T(ctx, "users.edit") }
								}
							}
							@components.ActionLink(props.Panel.BasePath+"/users", "button button--secondary button--compact", admini18n.T(ctx, "actions.list")) {
								<i class="ti ti-list" aria-hidden="true"></i>
								{ admini18n.T(ctx, "actions.list") }
							}
						</div>
						if props.CanManage && !props.User.Current {
							@components.DeleteButton(props.Panel.BasePath+"/users/"+props.User.ID+"/delete", admini18n.T(ctx, "users.delete_title", map[string]any{"Name": props.User.FullName(ctx)}), "icon-button icon-button--danger", admini18n.T(ctx, "users.delete")) {
								<i class="ti ti-trash" aria-hidden="true"></i>
							}
						}
					</header>
					<dl class="user-view__details">
						<div class="user-view__row">
							<dt>{ admini18n.T(ctx, "fields.first_name") }</dt>
							<dd>
								<div class="tag-list">
									@components.CopyValue(props.User.FirstName, admini18n.T(ctx, "fields.first_name"))
									if props.User.Current {
										<span class="badge">{ admini18n.T(ctx, "users.you") }</span>
									}
								</div>
							</dd>
						</div>
						<div class="user-view__row">
							<dt>{ admini18n.T(ctx, "fields.last_name") }</dt>
							<dd>
								@components.CopyValue(props.User.LastName, admini18n.T(ctx, "fields.last_name"))
							</dd>
						</div>
						<div class="user-view__row">
							<dt>{ admini18n.T(ctx, "fields.uuid") }</dt>
							<dd>
								@components.CopyValue(props.User.ID, admini18n.T(ctx, "fields.uuid"))
							</dd>
						</div>
						<div class="user-view__row">
							<dt>{ admini18n.T(ctx, "fields.email") }</dt>
							<dd>
								@components.CopyValue(props.User.Email, admini18n.T(ctx, "fields.email"))
							</dd>
						</div>
						<div class="user-view__row">
							<dt>{ admini18n.T(ctx, "fields.phone") }</dt>
							<dd>
								@components.CopyValue(props.User.Phone, admini18n.T(ctx, "fields.phone"))
							</dd>
						</div>
						<div class="user-view__row">
							<dt>{ admini18n.T(ctx, "fields.role") }</dt>
							<dd>
								@UserRole(props.Panel.BasePath, props.User, props.CanViewRoles)
							</dd>
						</div>
						<div class="user-view__row">
							<dt>{ admini18n.T(ctx, "fields.created_at") }</dt>
							<dd>{ props.User.CreatedAt }</dd>
						</div>
						<div class="user-view__row">
							<dt>{ admini18n.T(ctx, "fields.updated_at") }</dt>
							<dd>{ props.User.UpdatedAt }</dd>
						</div>
					</dl>
				</section>
			</div>
		</div>
	}
}
