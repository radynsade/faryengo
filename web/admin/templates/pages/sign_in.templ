package pages

import (
	admini18n "github.com/radynsade/faryengo/web/admin/i18n"
	"github.com/radynsade/faryengo/web/admin/templates/components"
	"github.com/radynsade/faryengo/web/admin/templates/layouts"
)

// SignInFormID names the region a failed in-page submission replaces.
const SignInFormID = "sign-in-form"

type SignInProps struct {
	Action             string
	RestorePasswordURL string
	Email              string
	Errors             []string
	FieldErrors        components.FieldErrors
}

templ SignIn(props SignInProps) {
	@layouts.AuthLayout(admini18n.T(ctx, "actions.sign_in"), admini18n.T(ctx, "auth.description")) {
		@SignInForm(props)
		<p class="auth-panel__footer">
			@components.PageLink(props.RestorePasswordURL) {
				{ admini18n.T(ctx, "auth.forgot") }
			}
		</p>
	}
}

// SignInForm is the region a failed submission replaces in place: the
// form-wide errors and the form. The password is never rendered back, even
// after a failed attempt.
templ SignInForm(props SignInProps) {
	<div id={ SignInFormID }>
		for _, message := range props.Errors {
			<p class="form-error" role="alert">{ message }</p>
		}
		<form class="form-stack" method="post" action={ templ.URL(props.Action) } { components.FormAttributes()... }>
			@components.TextInput(components.TextInputProps{
				ID:           "email",
				Name:         "email",
				Type:         "email",
				Label:        admini18n.T(ctx, "fields.email"),
				Placeholder:  admini18n.T(ctx, "fields.email_placeholder"),
				Autocomplete: "username",
				Value:        props.Email,
				Required:     true,
				Errors:       props.FieldErrors["email"],
			})
			@components.TextInput(components.TextInputProps{
				ID:           "password",
				Name:         "password",
				Type:         "password",
				Label:        admini18n.T(ctx, "fields.password"),
				Placeholder:  admini18n.T(ctx, "fields.password_placeholder"),
				Autocomplete: "current-password",
				Required:     true,
				Errors:       props.FieldErrors["password"],
			})
			@components.PrimaryButton("submit") {
				{ admini18n.T(ctx, "actions.sign_in") }
			}
		</form>
	</div>
}
