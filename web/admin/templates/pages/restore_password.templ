package pages

import (
	admini18n "github.com/radynsade/faryengo/web/admin/i18n"
	"github.com/radynsade/faryengo/web/admin/templates/components"
	"github.com/radynsade/faryengo/web/admin/templates/layouts"
)

// RestorePassword presents the recovery page; recovery is not submitted yet.
templ RestorePassword(signInURL string) {
	@layouts.AuthLayout(admini18n.T(ctx, "auth.restore"), admini18n.T(ctx, "auth.restore_description")) {
		<div class="form-stack">
			@components.TextInput(components.TextInputProps{
				ID:           "email",
				Name:         "email",
				Type:         "email",
				Label:        admini18n.T(ctx, "fields.email"),
				Placeholder:  admini18n.T(ctx, "fields.email_placeholder"),
				Autocomplete: "email",
			})
			@components.PrimaryButton("button") {
				{ admini18n.T(ctx, "auth.send_reset") }
			}
		</div>
		<p class="auth-panel__footer">
			@components.PageLink(signInURL) {
				{ admini18n.T(ctx, "auth.back") }
			}
		</p>
	}
}
