package pages

import (
	"github.com/radynsade/faryengo/web/admin/templates/components"
	"github.com/radynsade/faryengo/web/admin/templates/layouts"
)

// RestorePassword presents the email recovery page without submission behavior.
templ RestorePassword() {
	@layouts.AuthLayout("Restore password", "Enter your email address to reset your password.") {
		<div class="form-stack">
			@components.TextInput(components.TextInputProps{
				ID: "email",
				Name: "email",
				Type: "email",
				Label: "Email address",
				Placeholder: "you@example.com",
				Autocomplete: "email",
			})
			@components.PrimaryButton("button") {
				Send reset link
			}
		</div>
		<p class="auth-panel__footer">
			@components.PageLink("sign-in") {
				Back to sign in
			}
		</p>
	}
}
